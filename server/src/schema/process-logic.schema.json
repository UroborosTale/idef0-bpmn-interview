{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/process-logic-1.0.0.json",
  "title": "ProcessLogicModel",
  "description": "Промежуточная модель процесса (Process Logic JSON) — единый источник истины для генерации IDEF0 и BPMN. Версия схемы 1.0.0.",
  "type": "object",
  "required": ["schema_version", "process", "roles", "systems", "data", "controls", "nodes", "flows", "gaps", "statements"],
  "properties": {
    "schema_version": { "type": "string" },
    "process": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "department": { "type": "string" },
        "type": { "enum": ["AS-IS", "TO-BE"] },
        "goal": { "type": "string" },
        "trigger": { "type": "string" },
        "result": { "type": "string" },
        "decomposition_depth": { "type": "integer", "minimum": 1 },
        "notations": { "type": "array", "items": { "enum": ["IDEF0", "BPMN"] } }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["internal", "external"] },
          "source": { "$ref": "#/definitions/sourceList" }
        }
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "source": { "$ref": "#/definitions/sourceList" }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["document", "data"] },
          "source": { "$ref": "#/definitions/sourceList" }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["regulation", "rule", "norm"] },
          "source": { "$ref": "#/definitions/sourceList" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "status", "confidence", "source"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["task", "event", "gateway", "subprocess"] },
          "subtype": { "type": "string" },
          "name": { "type": "string" },
          "role_id": { "type": ["string", "null"] },
          "system_ids": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "controls": { "type": "array", "items": { "type": "string" } },
          "duration": { "type": ["string", "null"] },
          "frequency": { "type": ["string", "null"] },
          "idef0_parent": { "type": ["string", "null"] },
          "status": { "enum": ["confirmed", "hypothesis"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "$ref": "#/definitions/sourceList" }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "condition": { "type": ["string", "null"] },
          "source": { "$ref": "#/definitions/sourceList" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "priority", "question", "status"],
        "properties": {
          "id": { "type": "string" },
          "rule": { "type": "string" },
          "priority": { "enum": ["critical", "important", "desirable"] },
          "element_id": { "type": ["string", "null"] },
          "question": { "type": "string" },
          "status": { "enum": ["open", "answered", "dismissed"] }
        }
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["problem", "proposal"] },
          "text": { "type": "string" },
          "source": { "$ref": "#/definitions/sourceList" }
        }
      }
    }
  },
  "definitions": {
    "sourceList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fragment_id", "quote"],
        "properties": {
          "fragment_id": { "type": "string" },
          "quote": { "type": "string" }
        }
      }
    }
  }
}
