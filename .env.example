# Ключ Anthropic API для LLM-извлечения структуры процесса (ФТ-3). Приоритетный провайдер.
ANTHROPIC_API_KEY=

# Модель Anthropic (temperature=0, см. НФТ-3).
LLM_MODEL=claude-sonnet-4-5

# Облачный OpenAI-совместимый провайдер (используется, если нет ANTHROPIC_API_KEY).
# Данные уходят наружу, для конфиденциальных процессов не применяется.
# Пример для Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_OPENAI_MODEL=gemini-2.0-flash
# Пример для Groq:        https://api.groq.com/openai/v1
# Пример для OpenRouter:  https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_OPENAI_MODEL=

# Локальный провайдер (vLLM/Ollama) — только для конфиденциальных процессов.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Вход для аналитиков: логин:пароль через запятую (пароль лучше хэшем: npm run hash-password -w server -- <пароль>).
# Без AUTH_USERS вход отключён и сервер слушает только 127.0.0.1.
AUTH_USERS=
# HOST=0.0.0.0           # слушать все адреса (только вместе с AUTH_USERS)
# CORS_ORIGIN=           # чужие источники, которым разрешён доступ к API
# Внешний адрес приложения — попадёт в ссылки респондентам (без него берётся адрес, по которому открыт аналитик):
# PUBLIC_URL=http://192.168.1.10:8787

# Вызовы LLM: таймаут одного запроса (мс) и число повторов при 429/5xx/обрыве.
# LLM_TIMEOUT_MS=120000
# LLM_RETRIES=3
# Повторные проходы оркестратора (для платных LLM по умолчанию 1).
# AGENT_MAX_ITERATIONS=1
# Цены за 1 млн токенов (USD) — для оценки стоимости обработки.
# LLM_PRICE_INPUT_PER_M=
# LLM_PRICE_OUTPUT_PER_M=

# Резервные копии базы в data/backups: интервал в часах (0 — выключить) и сколько копий хранить.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# Вторая копия вне диска данных (сетевая папка, облачный каталог): копия на том же диске не переживёт его потерю.
# BACKUP_COPY_DIR=D:\Backups\process-modeling

# Токен агента Cline: даёт MCP-серверу доступ только к ручкам /api/agent/* (чтение модели, отправка предложений).
# Применять предложения агент не может. См. docs/agents/README.md.
AGENT_API_TOKEN=
